import {
  CategoriesResponse,
  CategoryDetailResponse,
  CreateCategoryPayload,
  UpdateCategoryPayload,
} from "./categories.types";
const API_BASE_URL = "/api/admin/categories";
type ApiFailure = {
  success: false;
  message: string;
  errors?: Record<string, string[]>;
  error_code: number;
};
function getAuthToken(): string {
  return (
    import.meta.env.VITE_ADMIN_PREVIEW_TOKEN ||
    localStorage.getItem("mindhub_api_token") ||
    ""
  );
}
function buildQuery(params: Record<string, unknown>): string {
  const query = new URLSearchParams();
  Object.entries(params).forEach(([key, value]) => {
    if (
      value !== undefined &&
      value !== null &&
      value !== "" &&
      value !== "all"
    ) {
      query.set(key, String(value));
    }
  });
  const value = query.toString();
  return value ? `?${value}` : "";
}
async function apiRequest<T>(
  url: string,
  options: RequestInit = {},
): Promise<T> {
  const headers = new Headers(options.headers || {});
  const token = getAuthToken();
  headers.set("Accept", "application/json");
  if (!(options.body instanceof FormData)) {
    headers.set("Content-Type", "application/json");
  }
  if (token) {
    headers.set("Authorization", `Bearer ${token}`);
  }
  let response: Response;
  try {
    response = await fetch(url, {
      credentials: "include",
      ...options,
      headers,
    });
  } catch (error) {
    console.error("Categories API network error:", error);
    return {
      success: false,
      message:
        "Không thể kết nối Backend. Kiểm tra php artisan serve tại cổng 8000.",
      errors: {},
      error_code: 0,
    } as T;
  }
  const payload = await response.json().catch(() => null);
  if (!response.ok) {
    const failure: ApiFailure = {
      success: false,
      message:
        payload?.message ||
        (response.status === 401
          ? "Token Admin local không hợp lệ hoặc đã hết hạn."
          : response.status === 403
            ? "Tài khoản hiện tại không có quyền quản trị."
            : `API Categories trả về lỗi HTTP ${response.status}.`),
      errors: payload?.errors || {},
      error_code: response.status,
    };
    return failure as T;
  }
  return payload as T;
}
export const CategoriesService = {
  async getCategories(
    params: Record<string, unknown> = {},
  ): Promise<CategoriesResponse> {
    return apiRequest<CategoriesResponse>(
      `${API_BASE_URL}${buildQuery(params)}`,
    );
  },
  async getCategoriesAll(
    status: string = "",
  ): Promise<CategoriesResponse> {
    const firstResponse = await this.getCategories({
      page: 1,
      per_page: 100,
      status,
    });
    if (!firstResponse.success) {
      return firstResponse;
    }
    let allItems = [...firstResponse.data.items];
    const lastPage = firstResponse.meta.last_page;
    if (lastPage > 1) {
      const requests: Promise<CategoriesResponse>[] = [];
      for (let page = 2; page <= lastPage; page += 1) {
        requests.push(
          this.getCategories({
            page,
            per_page: 100,
            status,
          }),
        );
      }
      const responses = await Promise.all(requests);
      for (const response of responses) {
        if (!response.success) {
          return response;
        }
        allItems = allItems.concat(response.data.items);
      }
    }
    return {
      ...firstResponse,
      data: {
        ...firstResponse.data,
        items: allItems,
      },
      meta: {
        ...firstResponse.meta,
        current_page: 1,
        last_page: 1,
        per_page: allItems.length || 100,
        total: allItems.length,
      },
    };
  },
  async getCategory(
    id: number | string,
  ): Promise<CategoryDetailResponse> {
    return apiRequest<CategoryDetailResponse>(
      `${API_BASE_URL}/${Number(id)}`,
    );
  },
  async createCategory(
    payload: CreateCategoryPayload,
  ): Promise<any> {
    return apiRequest(API_BASE_URL, {
      method: "POST",
      body: JSON.stringify(payload),
    });
  },
  async updateCategory(
    id: number | string,
    payload: UpdateCategoryPayload,
  ): Promise<any> {
    return apiRequest(`${API_BASE_URL}/${Number(id)}`, {
      method: "PATCH",
      body: JSON.stringify(payload),
    });
  },
  async deleteCategory(id: number | string): Promise<any> {
    return apiRequest(`${API_BASE_URL}/${Number(id)}`, {
      method: "DELETE",
    });
  },
  async restoreCategory(id: number | string): Promise<any> {
    return apiRequest(
      `${API_BASE_URL}/${Number(id)}/restore`,
      {
        method: "POST",
      },
    );
  },
  async reorderCategories(
    items: Array<{
      id: number;
      sort_order: number;
      parent_id: number | null;
    }>,
  ): Promise<any> {
    return apiRequest(`${API_BASE_URL}/reorder`, {
      method: "PUT",
      body: JSON.stringify({ items }),
    });
  },
};