datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  avatar              String?
  role                String   @default("student") // student, instructor, admin
  streak              Int      @default(0)
  lastActiveDate      String?
  bio                 String?
  phone               String?
  expertise           String?
  experienceYears     String?
  portfolioUrl        String?
  interestedTopics    String?  // JSON string
  status              String   @default("active")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  courses             Course[] @relation("InstructorCourses")
  enrollments         Enrollment[] @relation("UserEnrollments")
  activities          LearningActivity[] @relation("UserActivities")
  questions           CourseQuestion[] @relation("UserQuestions")
  answers             CourseAnswer[] @relation("UserAnswers")
  packagePurchases    Order[] @relation
  creditBalances      InstructorCourseCredit?
  creditTransactions  InstructorCreditTransaction[]
  coupons             Coupon[]
  revenues            Revenue[]
}

model Course {
  id                  String   @id @default(cuid())
  title               String
  subtitle            String?
  description         String?
  category            String
  subcategory         String?
  instructorId        String
  instructor          User     @relation("InstructorCourses", fields: [instructorId], references: [id])
  price               Float
  salePrice           Float?
  rating              Float    @default(0)
  reviewCount         Int      @default(0)
  enrolledCount       Int      @default(0)
  completionRate      Float    @default(0)
  isFeatured          Boolean  @default(false)
  isBestseller        Boolean  @default(false)
  isNew               Boolean  @default(false)
  image               String?
  status              String   @default("active") // draft, active, hidden, pending
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  chapters            Chapter[]
  enrollments         Enrollment[] @relation("CourseEnrollments")
  activities          LearningActivity[] @relation("CourseActivities")
  questions           CourseQuestion[] @relation("CourseQuestions")
  
  credit_used_at      DateTime?
  credit_transaction_id String?
  
  orders              Order[]
  creditTransactions  InstructorCreditTransaction[]
  coupons             Coupon[]
  revenues            Revenue[]
}

model Chapter {
  id                  String   @id @default(cuid())
  title               String
  courseId            String
  course              Course   @relation(fields: [courseId], references: [id])
  orderIndex          Int      @default(0)
  createdAt           DateTime @default(now())
  
  lessons             Lesson[]
}

model Lesson {
  id                  String   @id @default(cuid())
  title               String
  type                String   // video, quiz, assignment, doc
  duration            String?
  videoUrl            String?
  isPreview           Boolean  @default(false)
  content             String?
  chapterId           String
  chapter             Chapter  @relation(fields: [chapterId], references: [id])
  orderIndex          Int      @default(0)
  createdAt           DateTime @default(now())
}

model ContactMessage {
  id                  String   @id @default(cuid())
  name                String
  email               String
  subject             String
  message             String
  status              String   @default("pending") // pending, resolved
  createdAt           DateTime @default(now())
}

model Enrollment {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation("UserEnrollments", fields: [userId], references: [id])
  courseId            String
  course              Course   @relation("CourseEnrollments", fields: [courseId], references: [id])
  progress            Int      @default(0) // percentage 0-100
  completedAt         DateTime?
  certificateId       String?
  ratingStatus        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, courseId])
}

model LearningActivity {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation("UserActivities", fields: [userId], references: [id])
  courseId            String?
  course              Course?  @relation("CourseActivities", fields: [courseId], references: [id])
  lessonId            String?
  activityType        String   // "course_started", "lesson_completed", "course_completed", "quiz_passed"
  metadata            String?  // JSON string
  createdAt           DateTime @default(now())
}

model CourseQuestion {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation("CourseQuestions", fields: [courseId], references: [id])
  authorId    String
  author      User     @relation("UserQuestions", fields: [authorId], references: [id])
  content     String
  isInternal  Boolean  @default(false) // false: pre-purchase, true: post-purchase
  lessonId    String?
  status      String   @default("open") // open, answered, hidden
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  answers     CourseAnswer[] @relation("QuestionAnswers")
}

model CourseAnswer {
  id          String   @id @default(cuid())
  questionId  String
  question    CourseQuestion @relation("QuestionAnswers", fields: [questionId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation("UserAnswers", fields: [authorId], references: [id])
  content     String
  isInstructorAnswer Boolean @default(false)
  isAdminAnswer      Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CourseCreditPackage {
  id          String    @id @default(cuid())
  name        String
  description String?
  credits     Int
  price       Float
  status      String    @default("active") // active, inactive
  sort_order  Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  orders      Order[]

  @@map("course_credit_packages")
}

model Order {
  id                       String    @id @default(cuid())
  order_type               String    // "instructor_credit", "course_purchase"
  coupon_id                String?
  course_id                String?
  credit_package_id        String?
  package_snapshot_name    String?
  package_snapshot_credits Int?
  user_id                  String
  order_code               String    @unique
  status                   String    @default("pending") // pending, paid, cancelled, failed, expired
  price_snapshot           Float
  payment_method           String?   // "momo", "vnpay", "bank_transfer", "cash", "free"
  provider_transaction_id  String?
  amount                   Float
  payment_status           String    @default("unpaid") // unpaid, processing, paid, failed
  paid_at                  DateTime?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  user                     User      @relation(fields: [user_id], references: [id])
  package                  CourseCreditPackage? @relation(fields: [credit_package_id], references: [id])
  course                   Course?   @relation(fields: [course_id], references: [id])
  transactions             InstructorCreditTransaction[]

  @@map("orders")
}

model InstructorCourseCredit {
  id                String   @id @default(cuid())
  instructor_id     String   @unique
  total_credits     Int      @default(0)
  used_credits      Int      @default(0)
  remaining_credits Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user              User     @relation(fields: [instructor_id], references: [id])

  @@map("instructor_course_credits")
}

model InstructorCreditTransaction {
  id             String   @id @default(cuid())
  instructor_id  String
  order_id       String?
  course_id      String?
  type           String   // purchase, use, refund, adjust
  credits        Int
  balance_before Int
  balance_after  Int
  note           String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user           User     @relation(fields: [instructor_id], references: [id])
  order          Order?   @relation(fields: [order_id], references: [id])
  course         Course?  @relation(fields: [course_id], references: [id])

  @@unique([order_id, type])

  @@map("instructor_credit_transactions")
}

model Coupon {
  id               String   @id @default(cuid())
  user_id          String?
  course_id        String?
  code             String   @unique
  name             String
  description      String?
  discount_type    String   // percent, fixed
  discount_value   Float
  max_order_amount Float?
  usage_limit      Int?
  used_count       Int      @default(0)
  start_at         DateTime?
  end_at           DateTime?
  status           String   @default("active") // active, inactive, expired

  user             User?    @relation(fields: [user_id], references: [id])
  course           Course?  @relation(fields: [course_id], references: [id])

  @@map("coupons")
}

model Revenue {
  id                   String   @id @default(cuid())
  instructor_id        String
  course_id            String?
  order_id             String?
  gross_amount         Float
  instructor_amount    Float
  platform_fee_amount  Float
  status               String   @default("pending") // pending, available, paid
  earned_at            DateTime @default(now())
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  user                 User     @relation(fields: [instructor_id], references: [id])
  course               Course?  @relation(fields: [course_id], references: [id])

  @@map("revenues")
}
